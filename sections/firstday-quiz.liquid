{{ 'firstday-quiz.css' | asset_url | stylesheet_tag }}

<script src="{{ 'firstday-quiz.js' | asset_url }}" defer></script>

<section class="firstday-quiz" data-firstday-quiz>
  <div class="firstday-quiz__container">

    <div class="firstday-quiz__badge">
      ✨ Personalized in under 60 seconds
    </div>

    <h2>
      Find your family's perfect
      <br>
      First Day routine
    </h2>

    <p class="firstday-quiz__description">
      Answer a few questions and we'll recommend the right vitamins based on your needs.
    </p>

    <div class="quiz-progress" data-progress>
      Step 1 of 5
    </div>


    <div class="firstday-quiz__step active" data-step="1">
      <h3 class="quiz-question">
        Who are you shopping for?
      </h3>

      <div class="quiz-options">
        <button class="quiz-option" data-question="shopper" data-answer="child">
          🧒 My child
        </button>

        <button class="quiz-option" data-question="shopper" data-answer="family">
          👨‍👩‍👧 My family
        </button>

        <button class="quiz-option" data-question="shopper" data-answer="myself">
          👤 Myself
        </button>
      </div>
    </div>


    <div class="firstday-quiz__step" data-step="2">
      <h3 class="quiz-question">
        What are you looking to support?
      </h3>

      <div class="quiz-options">
        <button class="quiz-option" data-question="goal" data-answer="nutrition">
          💪 Daily Nutrition
        </button>

        <button class="quiz-option" data-question="goal" data-answer="gut">
          🌱 Gut Health
        </button>

        <button class="quiz-option" data-question="goal" data-answer="sleep">
          🌙 Sleep Support
        </button>

        <button class="quiz-option" data-question="goal" data-answer="immunity">
          🛡 Immunity
        </button>
      </div>
    </div>


    <div class="firstday-quiz__step" data-step="3">
      <h3 class="quiz-question">
        How would you describe their nutrition?
      </h3>

      <div class="quiz-options">
        <button class="quiz-option" data-question="habits" data-answer="picky">
          🍎 Picky eater
        </button>

        <button class="quiz-option" data-question="habits" data-answer="balanced">
          🥗 Balanced diet
        </button>

        <button class="quiz-option" data-question="habits" data-answer="active">
          🏃 Active lifestyle
        </button>
      </div>
    </div>


    <div class="firstday-quiz__step" data-step="4">
      <h3 class="quiz-question">
        What matters most in your routine?
      </h3>

      <div class="quiz-options">
        <button class="quiz-option" data-question="priority" data-answer="easy">
          ⏰ Simple daily habit
        </button>

        <button class="quiz-option" data-question="priority" data-answer="complete">
          ✨ Complete wellness
        </button>

        <button class="quiz-option" data-question="priority" data-answer="family">
          ❤️ Whole family health
        </button>
      </div>
    </div>


    <div class="firstday-quiz__step" data-step="5">
      <h3 class="quiz-question">
        What type of routine fits your lifestyle?
      </h3>

      <div class="quiz-options">
        <button class="quiz-option" data-question="routine" data-answer="simple">
          ⚡ Simple
        </button>

        <button class="quiz-option" data-question="routine" data-answer="complete">
          ✨ Complete
        </button>

        <button class="quiz-option" data-question="routine" data-answer="family">
          ❤️ Family
        </button>
      </div>
    </div>


    <div class="quiz-result hidden" data-result>
      <h2>
        Your First Day routine ✨
      </h2>

      <div data-products></div>

      <h3>
        Want us to send your routine?
      </h3>

      <input
        class="quiz-email"
        type="email"
        data-email
        placeholder="Email address"
      >

      <button class="quiz-submit" data-email-submit>
        Send my routine
      </button>

      <p class="hidden" data-success>
        Thanks! Your personalized routine is saved.
      </p>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "First Day Quiz",
  "settings": [],
  "presets": [
    {
      "name": "First Day Quiz"
    }
  ]
}
{% endschema %}