{{ 'firstday-quiz.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'firstday-quiz.js' | asset_url }}"
  defer
></script>

<section
  class="firstday-quiz"
  data-firstday-quiz
>
  <div class="firstday-quiz__container">
    <div class="firstday-quiz__badge">✨ Personalized in under 60 seconds</div>

    <h2>Find your family's perfect <br> First Day routine</h2>

    <p class="firstday-quiz__description">
      Answer a few questions and we'll recommend the right vitamins based on your needs.
    </p>

    <div
      class="quiz-progress"
      data-progress
    >
      Step 1 of 3
    </div>

    <div
      class="firstday-quiz__step active"
      data-step="1"
    >
      <h3 class="quiz-question">Who are you shopping for?</h3>

      <div class="quiz-options">
        <button
          class="quiz-option"
          data-question="shopper"
          data-answer="child"
        >
          🧒 My child
        </button>

        <button
          class="quiz-option"
          data-question="shopper"
          data-answer="family"
        >
          👨‍👩‍👧 My family
        </button>

        <button
          class="quiz-option"
          data-question="shopper"
          data-answer="myself"
        >
          👤 Myself
        </button>
      </div>
    </div>

    <div
      class="firstday-quiz__step"
      data-step="2"
    >
      <h3 class="quiz-question">What are you looking to support?</h3>

      <div class="quiz-options">
        <button
          class="quiz-option"
          data-question="goal"
          data-answer="nutrition"
        >
          💪 Daily Nutrition
        </button>

        <button
          class="quiz-option"
          data-question="goal"
          data-answer="gut"
        >
          🌱 Gut Health
        </button>

        <button
          class="quiz-option"
          data-question="goal"
          data-answer="sleep"
        >
          🌙 Sleep
        </button>
      </div>
    </div>

    <div
      class="firstday-quiz__step"
      data-step="3"
    >
      <h3 class="quiz-question">Where should we send your routine?</h3>

      <input
        class="quiz-email"

        type="email"

        data-email

        placeholder="Email address"
      >

      <br>

      <button
        class="quiz-submit"
        data-submit
      >
        Show my routine
      </button>
    </div>

    <div
      class="quiz-result hidden"
      data-result
    >
      <h2>Your First Day routine ✨</h2>

      <div
        data-products
      ></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "First Day Quiz",

  "settings": [],

  "presets": [
    {
      "name": "First Day Quiz"
    }
  ]
}
{% endschema %}
