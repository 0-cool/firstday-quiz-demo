{{ 'firstday-quiz.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'firstday-quiz.js' | asset_url }}"
  defer
></script>


<section
  class="firstday-quiz"
  data-firstday-quiz
>

<div class="firstday-quiz__container">


<div class="firstday-quiz__badge">
✨ Personalized in under 60 seconds
</div>


<h2>
Find your family's perfect <br>
First Day routine
</h2>


<p class="firstday-quiz__description">
Answer a few questions and we'll recommend the right vitamins based on your needs.
</p>



<div
class="quiz-progress"
data-progress
>
Step 1 of 5
</div>





<!-- STEP 1 -->

<div
class="firstday-quiz__step active"
data-step="1"
>


<h3 class="quiz-question">
Who are you shopping for?
</h3>


<div class="quiz-options">


<button
class="quiz-option"
data-question="shopper"
data-answer="child"
>
🧒 My child
</button>


<button
class="quiz-option"
data-question="shopper"
data-answer="family"
>
👨‍👩‍👧 My family
</button>


<button
class="quiz-option"
data-question="shopper"
data-answer="myself"
>
👤 Myself
</button>


</div>


</div>







<!-- STEP 2 -->

<div
class="firstday-quiz__step"
data-step="2"
>


<h3 class="quiz-question">
What are you looking to support?
</h3>


<div class="quiz-options">


<button
class="quiz-option"
data-question="goal"
data-answer="nutrition"
>
💪 Daily Nutrition
</button>


<button
class="quiz-option"
data-question="goal"
data-answer="gut"
>
🌱 Gut Health
</button>


<button
class="quiz-option"
data-question="goal"
data-answer="sleep"
>
🌙 Sleep Support
</button>


<button
class="quiz-option"
data-question="goal"
data-answer="immunity"
>
🛡 Immunity
</button>


</div>


</div>







<!-- STEP 3 -->

<div
class="firstday-quiz__step"
data-step="3"
>


<h3 class="quiz-question">
How would you describe their eating habits?
</h3>


<div class="quiz-options">


<button
class="quiz-option"
data-question="habits"
data-answer="picky"
>
🍎 Picky eater
</button>


<button
class="quiz-option"
data-question="habits"
data-answer="balanced"
>
🥗 Balanced diet
</button>


<button
class="quiz-option"
data-question="habits"
data-answer="active"
>
🏃 Active lifestyle
</button>


</div>


</div>








<!-- STEP 4 -->

<div
class="firstday-quiz__step"
data-step="4"
>


<h3 class="quiz-question">
What matters most in your daily routine?
</h3>


<div class="quiz-options">


<button
class="quiz-option"
data-question="priority"
data-answer="easy"
>
⏰ Easy daily habit
</button>


<button
class="quiz-option"
data-question="priority"
data-answer="complete"
>
✨ Complete wellness
</button>


<button
class="quiz-option"
data-question="priority"
data-answer="family"
>
❤️ Whole family health
</button>


</div>


</div>








<!-- STEP 5 -->

<div
class="firstday-quiz__step"
data-step="5"
>


<h3 class="quiz-question">
Where should we send your personalized routine?
</h3>



<input

class="quiz-email"

type="email"

data-email

placeholder="Email address"

>


<br>


<button
class="quiz-submit"
data-submit
>
Show my routine
</button>


</div>







<!-- RESULT -->

<div
class="quiz-result hidden"
data-result
>


<h2>
Your First Day routine ✨
</h2>


<div
data-products
></div>


</div>



</div>


</section>


{% schema %}
{
"name":"First Day Quiz",
"settings":[],
"presets":[
{
"name":"First Day Quiz"
}
]
}
{% endschema %}