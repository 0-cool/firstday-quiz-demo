{% assign quiz_product = all_products[handle] %}

{% if quiz_product %}
  <div class="quiz-product">
    <a href="{{ quiz_product.url }}">
      {% if quiz_product.featured_image %}
        <img
          src="{{ quiz_product.featured_image | image_url: width: 400 }}"
          alt="{{ quiz_product.title }}"
          loading="lazy"
        >
      {% endif %}

      <h3>
        {{ quiz_product.title }}
      </h3>

      <p>
        {{ quiz_product.price | money }}
      </p>
    </a>

    <a
      href="{{ quiz_product.url }}"
      class="quiz-product__button"
    >
      Shop now
    </a>
  </div>
{% endif %}
