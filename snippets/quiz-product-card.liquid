<div class="quiz-product">

  <a href="{{ product.url }}">
    {% if product.featured_image %}
        {{product | json }}
      <img
        src="{{ product.featured_image | image_url: width: 400 }}"
        alt="{{ product.title }}"
        loading="lazy"
      >
    {% endif %}

    <h3>
      {{ product.title }}
    </h3>

    <p>
      {{ product.price | money }}
    </p>
  </a>

  <a
    href="{{ product.url }}"
    class="quiz-product__button"
  >
    Shop now
  </a>

</div>